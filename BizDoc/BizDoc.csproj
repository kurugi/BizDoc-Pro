<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BizDoc</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'ReleaseNoSettings'">
    <AssemblyName>BizDoc-NoSettings</AssemblyName>
    <DefineConstants>$(DefineConstants);SETTINGS_DISABLED</DefineConstants>
    <Optimize>true</Optimize>
  </PropertyGroup>

</Project>